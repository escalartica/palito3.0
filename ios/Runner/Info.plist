<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Palito de Sabores</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Palito de Sabores</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneClassName</key>
                    <string>UIWindowScene</string>
                    <key>UISceneConfigurationName</key>
                    <string>flutter</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
                    <key>UISceneStoryboardFile</key>
                    <string>Main</string>
                </dict>
            </array>
        </dict>
    </dict>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    
    <!-- Permisos añadidos para evitar el bloqueo de la App -->
    <key>NSCameraUsageDescription</key>
    <string>Necesitamos acceso a la cámara para que puedas registrar tus recuerdos gastronómicos.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Necesitamos acceso a la galería para que puedas seleccionar fotos de tus platos.</string>

    <!-- Permiso de Ubicación: la app solo pide "when in use" en tiempo de
         ejecución, nunca en segundo plano. NSLocationAlwaysAndWhenInUseUsageDescription
         se declara igualmente (con el mismo texto) porque el plugin
         `geolocator` enlaza en el binario el código de autorización
         "always" aunque la app nunca lo invoque — sin esta clave, Apple
         rechaza la build en revisión por "Missing purpose string"
         (aviso real de Transporter al subir la build 5). -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Necesitamos tu ubicación para guardar dónde probaste este plato y mostrarlo en tu mapa de recuerdos.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Necesitamos tu ubicación para guardar dónde probaste este plato y mostrarlo en tu mapa de recuerdos.</string>

    <!-- ══ QUIÉN ES ESTA APP PARA GOOGLE, EN iOS ══

         `GoogleSignIn.initialize()` necesita el identificador de cliente de
         ESTA app. En Android se le pasa desde Dart, pero el de iOS es otro
         distinto y no puede salir del mismo sitio sin llenar el código de
         comprobaciones de plataforma. Así que el de iOS vive aquí, que es
         donde el propio plugin lo busca.

         Es el CLIENT_ID de GoogleService-Info.plist, copiado tal cual. Sin
         él, `initialize()` lanza una excepción nada más tocar el botón. -->
    <key>GIDClientID</key>
    <string>911590606586-j7op6japcoc4ftrptdtq7ludin6nmun5.apps.googleusercontent.com</string>

    <!-- ══ VUELTA DE GOOGLE AL ACCEDER ══

         El acceso con Google sale de la app a Safari y tiene que poder
         volver. Esta es la dirección por la que vuelve, y es el
         REVERSED_CLIENT_ID de GoogleService-Info.plist tal cual, con los
         trozos al revés.

         Si falta, el acceso con Google no falla con un error claro: se abre
         Safari, la persona elige su cuenta, y se queda ahí colgada sin
         volver nunca a la app. Es de los síntomas más desconcertantes que
         hay, porque parece un problema de red.

         Va escrito a mano en vez de generado porque este fichero no se
         regenera: si algún día se vuelve a descargar el
         GoogleService-Info.plist y el CLIENT_ID cambia, hay que cambiar
         también esta línea. Los dos tenían que decir lo mismo y nadie avisa
         cuando dejan de hacerlo. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>com.googleusercontent.apps.911590606586-j7op6japcoc4ftrptdtq7ludin6nmun5</string>
            </array>
        </dict>
    </array>
</dict>
</plist>