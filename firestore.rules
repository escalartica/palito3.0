rules_version = '2';

// Palito de Sabores — app privada del hogar de Eme y CeH, no
// multi-tenant. Todos los datos viven bajo users/{kHouseholdId} (ver
// lib/core/config/household_config.dart) y se comparten entre todos los
// dispositivos del hogar.
//
// Antes: bastaba con "request.auth != null" — cualquier sesión de
// Firebase Auth, incluida una anónima creada por un desconocido que
// solo necesitara conocer el projectId (no es secreto, viaja en el
// propio bundle de la app), podía leer/escribir todos los datos del
// hogar. Ahora se exige además que el uid de esa sesión esté en la
// whitelist de _isHouseholdMember() — los uids anónimos reales de los
// dispositivos del hogar (Firebase Console > Authentication > Users).
//
// Mantenimiento: instalar la app en un dispositivo nuevo (o borrar
// datos/reinstalar en uno existente) genera un uid anónimo distinto,
// que hay que añadir aquí a mano y volver a desplegar las reglas para
// que ese dispositivo pueda sincronizar. Es el coste de mantenimiento
// de este enfoque de coste cero — si el hogar dejara de ser un grupo
// pequeño y conocido de dispositivos, el paso natural sería sustituir
// esto por autenticación real (no anónima).
service cloud.firestore {
  match /databases/{database}/documents {
    function isHouseholdMember() {
      return request.auth != null && request.auth.uid in [
        'kazI88gXtoQTLM8vDgHQS1rcLrf2',
        'JYTa1rC8K5O3Gj4CE1aazAUT6AU2',
        'edyWrF7U3HPBbW6lKcuIzec0r0N2',
        '3RYayrII74T2vpALV1X75eVdGY42',
        'pqtpXx4WiOV3gVvhfmCOgiuqXw53',
        'fudChOtrc2S5S9JVoUXEBVz0ltB2',
        // iPhone de CeH — uids anónimos generados durante las
        // reinstalaciones del 27/08/2026 (cada `flutter install` hace un
        // desinstalar+instalar completo, lo que borra la sesión anónima
        // guardada en el llavero y genera un uid nuevo). Se guardan
        // todos por si acaso; cerrar/abrir la app normal SÍ conserva el
        // uid, solo una reinstalación completa lo cambia.
        'byNbd1IRAjRreG5dDKBHzKfQmhm1',
        'ZQA4t7bibeXxWuoSj2QLwVZ5imC3'
      ];
    }

    match /users/{userId} {
      allow read, write: if isHouseholdMember();
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isHouseholdMember();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
