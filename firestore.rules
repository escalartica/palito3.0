rules_version = '2';

// Palito de Sabores — reglas para el modelo multi-tenant (households +
// cuentas reales con Sign in with Apple), en sustitución del modelo
// anterior de un único hogar fijo (users/{kHouseholdId}) con una
// whitelist de uids anónimos.
//
// Modelo:
//   users/{uid}              — perfil propio de cada usuario (solo él
//                               puede leerlo/escribirlo). Guarda
//                               `householdId`: a qué hogar pertenece.
//   households/{householdId} — datos compartidos por sus miembros
//                               (memories, locations, gamer_stats,
//                               game_history, profileImages).
//   invites/{code}            — códigos de invitación de un solo uso
//                               para unirse a un hogar.
//
// IMPORTANTE (no desplegar todavía): estas reglas asumen que la app ya
// resuelve el hogar del usuario a partir de users/{uid}.householdId
// (ver lib/core/providers/household_provider.dart) en vez del antiguo
// kHouseholdId fijo. Desplegarlas antes de que la Fase B (Sign in with
// Apple) y la Fase E (migración de los datos reales) estén completas
// cortaría el acceso de los dos usuarios actuales, que siguen
// funcionando hoy con sesión anónima sobre users/palito-hogar/**. Los
// datos antiguos bajo ese documento no se tocan aquí — quedan como
// copia de seguridad de solo-Consola hasta la migración.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Lee el propio documento users/{uid} del solicitante para saber a
    // qué hogar pertenece, sin necesitar pasarlo como segmento de ruta.
    function callerHouseholdId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId;
    }

    function isHouseholdMember(householdId) {
      return isSignedIn() && householdId == callerHouseholdId();
    }

    // Añadir el propio uid a members es el único cambio permitido a un
    // hogar del que todavía no se es miembro — es el paso de "unirse
    // con código" (ver invites/{code} más abajo), que necesariamente
    // ocurre antes de que isHouseholdMember() empiece a devolver true
    // para este usuario.
    function isJoiningHousehold() {
      return isSignedIn()
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.members.hasOnly(
             resource.data.members.concat([request.auth.uid])
           )
        && request.resource.data.members.hasAll(resource.data.members);
    }

    // ---------------- users/{uid} ----------------
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ---------------- households/{householdId} ----------------
    match /households/{householdId} {
      allow read: if isHouseholdMember(householdId);
      allow create: if isSignedIn()
        && request.resource.data.members.hasOnly([request.auth.uid])
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isHouseholdMember(householdId)
        || isJoiningHousehold();

      match /{subcollection}/{document=**} {
        allow read, write: if isHouseholdMember(householdId);
      }
    }

    // ---------------- invites/{code} ----------------
    match /invites/{code} {
      // Solo lectura por ID exacto — nunca se concede `list`, así que la
      // colección no se puede enumerar aunque cualquier usuario
      // autenticado pueda resolver un código concreto que ya conozca.
      allow get: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.householdId == callerHouseholdId()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.usedBy == null
        && request.resource.data.useCount == 0;

      allow update: if isSignedIn()
        && resource.data.useCount < resource.data.maxUses
        && resource.data.expiresAt > request.time
        && request.resource.data.householdId == resource.data.householdId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.maxUses == resource.data.maxUses;

      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
