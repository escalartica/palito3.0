rules_version = '2';

// Palito de Sabores — app privada de 2 personas (Eme y CeH), no
// multi-tenant. Todos los datos viven bajo users/{kHouseholdId} (ver
// lib/core/config/household_config.dart) y se comparten entre todos los
// dispositivos del hogar. La única barrera de seguridad es exigir sesión
// de Firebase Auth (anónima o no) — no hay aislamiento por uid porque el
// objetivo del producto es precisamente que ambos móviles vean los
// mismos datos.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /game_sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }

    match /memories/{memoryId} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
