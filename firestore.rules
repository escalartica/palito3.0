rules_version = '2';

// =============================================================================
// Palito de Sabores — reglas de Firestore
// =============================================================================
//
// Modelo:
//   users/{uid}       — perfil propio de cada usuario (solo él lo lee/escribe).
//                       Guarda `groupIds` y `personalGroupId`. Es una lista de
//                       CONVENIENCIA para la app, NUNCA la fuente de
//                       autorización: quien decide el acceso es el campo
//                       `members` del propio documento del grupo.
//   groups/{groupId}  — datos compartidos por sus miembros (memories,
//                       locations, gamer_stats, game_history, profileImages).
//                       Cada usuario tiene siempre al menos uno (su diario
//                       personal, `isPersonal: true`, nunca invitable).
//   invites/{code}    — códigos de invitación para unirse a un grupo.
//
// CAMBIO IMPORTANTE respecto a la versión anterior:
// unirse a un grupo ya NO basta con conocer su `groupId`. Ahora el servidor
// exige que exista una invitación válida, sin caducar, cuyo `groupId` coincida
// y que ya haya sido reclamada por quien se une (`usedBy == request.auth.uid`).
// El flujo del cliente es, en este orden:
//   1) update invites/{code}  -> usedBy = uid, useCount + 1   (reclamar)
//   2) update groups/{gid}    -> members += uid, lastJoinCode = code  (entrar)
//   3) set    users/{uid}     -> groupIds += gid              (cosmético)
// El paso 2 es idempotente: si falla se puede reintentar sin volver a gastar
// el código, porque la regla comprueba `usedBy`, no `useCount`.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // Helpers generales
    // -------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isMemberOf(members) {
      return isSignedIn() && request.auth.uid in members;
    }

    // Versión "por id" — hace un get() explícito al documento del grupo, para
    // contextos donde `resource` no es ya ese documento (subcolecciones,
    // invites/{code}).
    function isGroupMember(groupId) {
      return isMemberOf(
        get(/databases/$(database)/documents/groups/$(groupId)).data.members
      );
    }

    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    // -------------------------------------------------------------------
    // users/{uid}
    // -------------------------------------------------------------------

    match /users/{uid} {
      allow read: if isOwner(uid);

      // Sin lista blanca de campos: es el documento del propio usuario y hay
      // instalaciones antiguas con campos heredados. Lo que sí se acota es el
      // tamaño, para que un cliente manipulado no pueda inflarlo.
      allow write: if isOwner(uid)
        && request.resource.data.keys().size() <= 25
        && (!('displayName' in request.resource.data)
             || request.resource.data.displayName == null
             || (request.resource.data.displayName is string
                 && request.resource.data.displayName.size() <= 40))
        && (!('groupIds' in request.resource.data)
             || (request.resource.data.groupIds is list
                 && request.resource.data.groupIds.size() <= 50));

      allow delete: if isOwner(uid);
    }

    // -------------------------------------------------------------------
    // groups/{groupId}
    // -------------------------------------------------------------------

    match /groups/{groupId} {

      // --- helpers de grupo -------------------------------------------

      function existing() {
        return resource.data;
      }

      function incoming() {
        return request.resource.data;
      }

      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Campos que nadie puede modificar nunca después de la creación.
      function immutablesUntouched() {
        return incoming().createdBy == existing().createdBy
          && incoming().isPersonal == existing().isPersonal;
      }

      function validName() {
        return !('name' in incoming())
          || (incoming().name is string && incoming().name.size() <= 60);
      }

      // Solo puedes tocar TU entrada dentro de estos dos mapas.
      function onlyOwnEntryIn(field) {
        return !(field in changedKeys())
          || incoming()[field].diff(existing().get(field, {}))
               .affectedKeys().hasOnly([request.auth.uid]);
      }

      // 1) Edición normal por un miembro: no toca `members` ni los campos
      //    inmutables, y solo cambia su propia foto/perfil.
      function memberEdit() {
        return isMemberOf(existing().members)
          && !('members' in changedKeys())
          && immutablesUntouched()
          && validName()
          && onlyOwnEntryIn('profileImages')
          && onlyOwnEntryIn('memberProfiles');
      }

      // 2) Salir del grupo por cuenta propia: solo te quitas a ti.
      function selfLeave() {
        return isMemberOf(existing().members)
          && immutablesUntouched()
          && incoming().members == existing().members.removeAll([request.auth.uid]);
      }

      // 3) Expulsar a otro. Lo puede hacer quien creó el grupo; si el creador
      //    ya no es miembro (se fue), cualquier miembro puede hacerlo para que
      //    el grupo no quede ingobernable.
      function canModerate() {
        return request.auth.uid == existing().createdBy
          || !(existing().createdBy in existing().members);
      }

      function moderatorRemove() {
        return isMemberOf(existing().members)
          && canModerate()
          && immutablesUntouched()
          && incoming().members.hasOnly(existing().members)   // nunca añade
          && request.auth.uid in incoming().members;          // no se autoexpulsa
      }

      // 4) Unirse con una invitación ya reclamada por este usuario.
      //    `lastJoinCode` es el código que el cliente acaba de gastar; el
      //    servidor comprueba contra invites/{code} que sea real, que apunte a
      //    este grupo, que no haya caducado y que quien la reclamó sea quien
      //    está entrando. Sin esto, conocer el id del grupo bastaba para
      //    colarse.
      function claimedInvite() {
        return get(
          /databases/$(database)/documents/invites/$(incoming().lastJoinCode)
        ).data;
      }

      function isJoiningWithInvite() {
        return isSignedIn()
          && !(request.auth.uid in existing().members)
          && existing().isPersonal == false
          && existing().members.size() > 0        // nunca un grupo huérfano
          && immutablesUntouched()
          && incoming().lastJoinCode is string
          && incoming().members.hasAll(existing().members)
          && incoming().members.hasOnly(
               existing().members.concat([request.auth.uid])
             )
          && claimedInvite().groupId == groupId
          && claimedInvite().usedBy == request.auth.uid
          && claimedInvite().expiresAt > request.time;
      }

      // --- reglas ------------------------------------------------------

      allow read: if isMemberOf(resource.data.members);

      allow create: if isSignedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.isPersonal is bool
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;

      allow update: if memberEdit()
        || selfLeave()
        || moderatorRemove()
        || isJoiningWithInvite();

      // Un grupo se puede borrar cuando quien lo borra es su último miembro.
      // Hace falta para que "Eliminar cuenta" no deje grupos huérfanos
      // (antes no existía ninguna regla de delete: eran indestructibles).
      allow delete: if isMemberOf(resource.data.members)
        && resource.data.members.hasOnly([request.auth.uid]);

      // --- subcolecciones ----------------------------------------------

      match /memories/{memoryId} {
        allow read, delete: if isGroupMember(groupId);
        allow create, update: if isGroupMember(groupId)
          && request.resource.data.keys().size() <= 40
          && (!('rating' in request.resource.data)
               || request.resource.data.rating == null
               || (request.resource.data.rating is number
                   && request.resource.data.rating >= 0
                   && request.resource.data.rating <= 5))
          && (!('title' in request.resource.data)
               || (request.resource.data.title is string
                   && request.resource.data.title.size() <= 200))
          && (!('imageUrls' in request.resource.data)
               || (request.resource.data.imageUrls is list
                   && request.resource.data.imageUrls.size() <= 10));
      }

      match /locations/{locationId} {
        allow read, write: if isGroupMember(groupId)
          && (request.method == 'delete'
              || request.resource.data.keys().size() <= 20);
      }

      // gamer_stats y game_history: escritura solo para miembros, con tope de
      // tamaño para que un cliente manipulado no pueda inflar el documento.
      match /{sub}/{document=**} {
        allow read: if isGroupMember(groupId)
          && sub in ['gamer_stats', 'game_history'];
        allow write: if isGroupMember(groupId)
          && sub in ['gamer_stats', 'game_history']
          && (request.method == 'delete'
              || request.resource.data.keys().size() <= 40);
      }
    }

    // -------------------------------------------------------------------
    // invites/{code}
    // -------------------------------------------------------------------

    match /invites/{code} {

      // Lectura por ID exacto: quien tiene el código puede resolverlo. Nunca
      // se concede `list` a cualquiera, así que la colección no es enumerable.
      allow get: if isSignedIn();

      // Un miembro del grupo sí puede listar las invitaciones de SU grupo,
      // para poder revocarlas. (Antes no podía, así que un código filtrado era
      // irrevocable en la práctica.)
      allow list: if isSignedIn() && isGroupMember(resource.data.groupId);

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
             'groupId', 'createdBy', 'createdAt', 'expiresAt',
             'usedBy', 'usedAt', 'maxUses', 'useCount'
           ])
        && request.resource.data.groupId is string
        && isGroupMember(request.resource.data.groupId)
        && groupData(request.resource.data.groupId).isPersonal == false
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.usedBy == null
        && request.resource.data.useCount == 0
        && request.resource.data.maxUses is int
        && request.resource.data.maxUses >= 1
        && request.resource.data.maxUses <= 20
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt
             < request.time + duration.value(31, 'd');

      // Reclamar un código. Solo se pueden tocar tres campos, `useCount` solo
      // puede subir de uno en uno y `usedBy` tiene que ser quien escribe.
      // Antes la regla no miraba los valores NUEVOS, así que cualquiera podía
      // poner useCount = 0 y expiresAt = año 2099 y dejar el código eterno.
      allow update: if isSignedIn()
        && resource.data.useCount < resource.data.maxUses
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['usedBy', 'usedAt', 'useCount'])
        && request.resource.data.useCount == resource.data.useCount + 1
        && request.resource.data.usedBy == request.auth.uid;

      // Revocar: quien la creó, o cualquier miembro del grupo al que apunta.
      allow delete: if isSignedIn()
        && (resource.data.createdBy == request.auth.uid
            || isGroupMember(resource.data.groupId));
    }

    // -------------------------------------------------------------------
    // Todo lo demás, denegado.
    // -------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
