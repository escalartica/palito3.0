rules_version = '2';

// Palito de Sabores — reglas para el modelo multi-tenant con grupos
// múltiples por persona (cuentas reales con Sign in with Apple).
//
// Modelo:
//   users/{uid}       — perfil propio de cada usuario (solo él puede
//                        leerlo/escribirlo). Guarda `groupIds`: todos los
//                        grupos a los que pertenece (empezando siempre
//                        por su grupo personal, `personalGroupId`) — es
//                        una lista de conveniencia para la app (saber qué
//                        grupos mostrar), NO la fuente de autorización:
//                        ver la nota en isGroupMember/isMemberOf de abajo.
//   groups/{groupId}  — datos compartidos por sus miembros (memories,
//                        locations, gamer_stats, game_history,
//                        profileImages). Cada usuario tiene siempre al
//                        menos uno (su diario personal, `isPersonal:
//                        true`, un solo miembro, nunca invitable). El
//                        campo `members` de este documento es la fuente
//                        de verdad de quién pertenece al grupo.
//   invites/{code}    — códigos de invitación de un solo uso para
//                        unirse a un grupo (nunca al personal).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // La autorización se basa SIEMPRE en `members` del propio documento
    // del grupo (la lista que un creador/miembro puede editar para
    // expulsar a alguien), nunca en `users/{uid}.groupIds` — ese campo lo
    // controla cada usuario sobre sí mismo, así que basar el acceso ahí
    // significaría que alguien expulsado de un grupo (con su entrada
    // borrada de `members`, pero sin que nadie más pueda tocar su propio
    // `groupIds`) seguiría teniendo acceso de lectura/escritura mientras
    // su documento de usuario siguiera mencionando ese grupo.
    function isMemberOf(members) {
      return isSignedIn() && request.auth.uid in members;
    }

    // Versión "por id" de isMemberOf — hace un get() explícito al
    // documento del grupo, para usar en contextos donde `resource` no es
    // ya ese documento (subcolecciones, invites/{code}).
    function isGroupMember(groupId) {
      return isMemberOf(
        get(/databases/$(database)/documents/groups/$(groupId)).data.members
      );
    }

    // Añadir el propio uid a members es el único cambio permitido a un
    // grupo del que todavía no se es miembro — es el paso de "unirse
    // con código" (ver invites/{code} más abajo), que necesariamente
    // ocurre antes de que isMemberOf() empiece a devolver true para
    // este usuario.
    function isJoiningGroup() {
      return isSignedIn()
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.members.hasOnly(
             resource.data.members.concat([request.auth.uid])
           )
        && request.resource.data.members.hasAll(resource.data.members);
    }

    // ---------------- users/{uid} ----------------
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ---------------- groups/{groupId} ----------------
    match /groups/{groupId} {
      // Usa resource.data.members directamente (ya lo tenemos aquí, sin
      // necesidad de un get() adicional) — mismo criterio que
      // isMemberOf/isGroupMember, solo que sin el lookup redundante.
      allow read: if isMemberOf(resource.data.members);
      allow create: if isSignedIn()
        && request.resource.data.members.hasOnly([request.auth.uid])
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isMemberOf(resource.data.members)
        || isJoiningGroup();

      match /{subcollection}/{document=**} {
        allow read, write: if isGroupMember(groupId);
      }
    }

    // ---------------- invites/{code} ----------------
    match /invites/{code} {
      // Solo lectura por ID exacto — nunca se concede `list`, así que la
      // colección no se puede enumerar aunque cualquier usuario
      // autenticado pueda resolver un código concreto que ya conozca.
      allow get: if isSignedIn();

      allow create: if isSignedIn()
        && isGroupMember(request.resource.data.groupId)
        && !get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.isPersonal
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.usedBy == null
        && request.resource.data.useCount == 0;

      allow update: if isSignedIn()
        && resource.data.useCount < resource.data.maxUses
        && resource.data.expiresAt > request.time
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.maxUses == resource.data.maxUses;

      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
