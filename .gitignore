# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Herramientas de desarrollo asistido (no forman parte de la app)
.agents/
.claude/
skills-lock.json

# Caché local de la CLI de Firebase
.firebase/

# Firma de release de Android — nunca debe subirse al repositorio
android/key.properties
*.jks
*.keystore

# Scripts de administración (Fase E) — credenciales y dependencias, nunca al repo
scripts/node_modules/
scripts/*.json
!scripts/package.json
scripts/*serviceAccount*
scripts/*service-account*
